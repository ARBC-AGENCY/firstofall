# Cachet Infalsifiable deployment — brand configuration only.
# Copy to .env.cachet, then: npm run dev:cachet
#
# Secrets (Supabase, Resend, admin) are NOT repeated here: they stay in
# .env.local and are shared by both brands. Never put a secret in this file.

NEXT_PUBLIC_BRAND_ID=cachet-infalsifiable
NEXT_PUBLIC_BRAND_NAME=Cachet Infalsifiable
NEXT_PUBLIC_BRAND_SYMBOL=™
NEXT_PUBLIC_BRAND_DOMAIN=cachetinfalsifiable.com
NEXT_PUBLIC_BRAND_CONTACT_EMAIL=contact@cachetinfalsifiable.com

# No registrations held under this name yet — hides jurisdiction badges and
# the "internationally protected trademark" wording.
NEXT_PUBLIC_BRAND_HAS_IP=false

# The brand name already contains the product noun, so leave both empty
# (otherwise: "Cachet Cachet Infalsifiable").
NEXT_PUBLIC_BRAND_PRODUCT_NOUN_FR=
NEXT_PUBLIC_BRAND_PRODUCT_NOUN_EN=

# No logo asset yet — falls back to the text wordmark. When the client sends
# one, drop it in public/brand/ and point this at it.
NEXT_PUBLIC_BRAND_LOGO=

# Parent Maison — drives the "Une invention First of All™" attribution.
NEXT_PUBLIC_PARENT_BRAND_ID=first-of-all
NEXT_PUBLIC_PARENT_BRAND_NAME=First of All
NEXT_PUBLIC_PARENT_BRAND_SYMBOL=™
NEXT_PUBLIC_PARENT_BRAND_URL=https://firstofall.net
