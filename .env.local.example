# ─────────────────────────────────────────────────────────────
# TEMPLATE — committed to git. NEVER put real values in this file.
# Copy it to .env.local (gitignored) and fill the secrets there.
# ─────────────────────────────────────────────────────────────

# ── Brand — the only block that differs between deployments ──
# Omit everything here to get the original First of All site.
#
# Slug written to the `brand` column in Supabase. Must be stable:
# changing it orphans every row already recorded under the old value.
NEXT_PUBLIC_BRAND_ID=first-of-all
NEXT_PUBLIC_BRAND_NAME=First of All
# Trademark symbol appended to the name. Empty string is valid.
NEXT_PUBLIC_BRAND_SYMBOL=™
NEXT_PUBLIC_BRAND_DOMAIN=firstofall.net
NEXT_PUBLIC_BRAND_CONTACT_EMAIL=contact@firstofall.net
# Wordmark served from /public, with its intrinsic pixel size. Set to an empty
# string to fall back to the text mark — a brand with no logo asset yet must
# not inherit another brand's logo.
NEXT_PUBLIC_BRAND_LOGO=/brand/first-of-all.png
NEXT_PUBLIC_BRAND_LOGO_WIDTH=4500
NEXT_PUBLIC_BRAND_LOGO_HEIGHT=1000
# The wordmark is black artwork, so it is inverted to white on dark surfaces
# (footer, and the header before it turns light). Set false for a light logo.
NEXT_PUBLIC_BRAND_LOGO_INVERT_ON_DARK=true
# Browser tab icon. Empty string = browser default, no icon inherited.
NEXT_PUBLIC_BRAND_FAVICON=/brand/first-of-all-icon.png
# Header background once scrolled: "light" (white) or "dark" (black).
NEXT_PUBLIC_BRAND_HEADER_SCROLLED=light
# Set to false for any brand that does not itself hold the EUIPO / OAPI /
# USPTO / Canada / UK registrations. It hides the jurisdiction badges and
# the "internationally protected trademark" wording rather than restating
# them under a name they do not cover.
NEXT_PUBLIC_BRAND_HAS_IP=true

# Product noun used with the brand name. Leave BOTH empty when the brand name
# already contains it, or copy reads "Cachet Cachet Infalsifiable".
NEXT_PUBLIC_BRAND_PRODUCT_NOUN_FR=sceau
NEXT_PUBLIC_BRAND_PRODUCT_NOUN_EN=seal

# ── Parent brand (the Maison carrying the invention) ──
# Leave as-is on the parent's own deployment. When BRAND_ID differs from
# PARENT_BRAND_ID the site credits the parent: header badge, hero line,
# brand-architecture section and footer attribution. Maison-level entities
# (the Business Club, the Silicon Valley funding, trademark and company
# notices) keep naming the parent on every deployment.
NEXT_PUBLIC_PARENT_BRAND_ID=first-of-all
NEXT_PUBLIC_PARENT_BRAND_NAME=First of All
NEXT_PUBLIC_PARENT_BRAND_SYMBOL=™
NEXT_PUBLIC_PARENT_BRAND_URL=https://firstofall.net

# ── Supabase — shared across brands, rows partitioned by `brand` ──
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Resend (email) — per-brand sending domain, verified in Resend DNS ──
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@firstofall.net
ADMIN_EMAIL=contact@firstofall.net

# ── Admin dashboard ──
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_SESSION_SECRET=generate_a_long_random_string
